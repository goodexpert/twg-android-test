# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Kotlin incremental compilation cache
.kotlin/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Claude & AI Configs
.claude/
CLAUDE.md

# Environment files
.env
.env.local
.env.development.local
.env.production.local

# PR screenshots — uploaded via `gh --attach`, never committed.
# Naming: <ticket>.<platform>[.<screen>].<before|after>.<ext>
screenshots/

# Per-developer Xcode signing settings. Config.xcconfig pulls this in with an optional
# `#include?`, so a clone without it still builds — TEAM_ID just resolves empty, which is
# all a simulator build needs.
iosApp/Configuration/Local.xcconfig

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md
fastlane/.env
fastlane/*.json
